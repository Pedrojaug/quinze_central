# Domínio público atendido pelo Traefik na VPS
APP_HOST=quinze-central.inteligentte.com.br

# Banco Neon Postgres (copiar da Vercel -> Settings -> Environment Variables)
DATABASE_URL=postgresql://usuario:senha@ep-xxxxx.aws.neon.tech/neondb?sslmode=require

# Segurança e crons (copiar da Vercel ou gerar strings seguras)
MASTER_PASS_HASH=
CRON_SECRET=

# Integrações opcionais (preencher só as que já estiverem configuradas na Vercel)
GOOGLE_SERVICE_ACCOUNT_JSON=
DRIVE_PASTA_ASSINADOS_ID=

WHATSAPP_API_URL=
WHATSAPP_TOKEN=
WHATSAPP_DESTINO=
WHATSAPP_TESTE=

OPENAI_API_KEY=
OPENAI_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
ANTHROPIC_WORKSPACE_ID=

IMAP_HOST=
IMAP_PORT=

# Observação VPS:
# NÃO defina BLOB_READ_WRITE_TOKEN nem BLOB_ACCESS aqui — o docker-compose já define
# ARQUIVOS_DIR=/data/arquivos para salvar peças/PDFs no volume persistente da VPS.

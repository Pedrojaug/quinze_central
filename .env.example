# ==============================================================================
# QUINZE CENTRAL - VARIÁVEIS DE AMBIENTE (.env.example)
# ==============================================================================
# Copie este arquivo para .env.local no ambiente local ou adicione no painel da Vercel.
# NUNCA commite senhas ou chaves reais no repositório.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. BANCO DE DADOS (OBRIGATÓRIO)
# ------------------------------------------------------------------------------
# Conexão PostgreSQL com o Neon Serverless (SSL obrigatório)
DATABASE_URL="postgresql://usuario:senha@ep-xyz-123.sa-east-1.aws.neon.tech/neondb?sslmode=require"

# (Opcional) Endpoint de branch do Neon para deploys de Preview na Vercel
# DB_ENDPOINT_PREVIEW="ep-branch-preview-12345"

# ------------------------------------------------------------------------------
# 2. SEGURANÇA E TAREFAS AGENDADAS (CRONS)
# ------------------------------------------------------------------------------
# Segredo para autenticar as chamadas de Vercel Cron (/api/cron/...)
CRON_SECRET="seu_segredo_aleatorio_super_seguro_aqui"

# ------------------------------------------------------------------------------
# 3. ARMAZENAMENTO DE ARQUIVOS (VERCEL BLOB)
# ------------------------------------------------------------------------------
# Token de leitura e escrita do Vercel Blob para upload de anexos e contratos.
# Se vazio, o sistema usa diretório temporário local (/tmp/qz-arquivos).
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxxxxxxxxxxxxxxxxxxxxxxxxx"

# ------------------------------------------------------------------------------
# 4. INTELIGÊNCIA ARTIFICIAL (ANTHROPIC CLAUDE)
# ------------------------------------------------------------------------------
# Chave da API Anthropic para recursos de sugestão de POPs e relatórios com IA.
ANTHROPIC_API_KEY="sk-ant-api03-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# ANTHROPIC_MODEL="claude-3-5-sonnet-20241022"
# ANTHROPIC_WORKSPACE_ID=""

# ------------------------------------------------------------------------------
# 5. INTEGRAÇÃO WHATSAPP (NOTIFICAÇÕES E TAREFAS)
# ------------------------------------------------------------------------------
# Gateway de envio de mensagens para lembretes diários e relatórios às 20h.
WHATSAPP_API_URL="https://api.gateway-whatsapp.com.br"
WHATSAPP_TOKEN="token_do_gateway_whatsapp"
WHATSAPP_DESTINO="5584999999999"
WHATSAPP_TESTE="5584988888888"

# ------------------------------------------------------------------------------
# 6. GOOGLE WORKSPACE (DRIVE & FORMS NPS)
# ------------------------------------------------------------------------------
# JSON da Service Account Google (em uma única linha ou escapado)
GOOGLE_SERVICE_ACCOUNT_JSON='{"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}'
DRIVE_PASTA_ASSINADOS_ID="id_da_pasta_no_google_drive"
GOOGLE_FORMS_DONO_EMAIL="contato@quinzecomunicacao.com.br"

# ------------------------------------------------------------------------------
# 7. E-MAIL CORPORATIVO (LOGIN IMAP LOCAWEB)
# ------------------------------------------------------------------------------
# Configurações para autenticação direta via e-mail corporativo da agência.
IMAP_HOST="email-ssl.com.br"
IMAP_PORT=993
